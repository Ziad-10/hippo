<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Replace YOUR_USER, then copy to ~/Library/LaunchAgents/local.moodle-sync.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>local.moodle-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>/Users/YOUR_USER/moodle-sync/moodle_sync.py</string>
    <string>sync</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>0</integer></dict>
  </array>
  <key>StandardOutPath</key><string>/Users/YOUR_USER/moodle-sync/logs/sync.log</string>
  <key>StandardErrorPath</key><string>/Users/YOUR_USER/moodle-sync/logs/sync.log</string>
</dict>
</plist>
